<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lõi gộp DWG: chỉ tham chiếu acdbmgd + accoremgd để chạy được cả trong AutoCAD Core Console -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VXT.GopCAD.Core</AssemblyName>
    <RootNamespace>VXT.GopCAD.Core</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Authors>Vũ Xuân Tuyến</Authors>
    <OutputPath>..\..\bin\AutoCAD\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Đổi đường dẫn nếu AutoCAD cài chỗ khác:  dotnet build -p:AcadDir="D:\AutoCAD 2024\" -->
    <AcadDir Condition="'$(AcadDir)'==''">C:\Program Files\Autodesk\AutoCAD 2024\</AcadDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadDir)acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
