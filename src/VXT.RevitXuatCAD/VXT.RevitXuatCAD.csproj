<Project Sdk="Microsoft.NET.Sdk">

  <!-- Add-in Revit 2025 (.NET 8): chọn sheet, xuất DWG, gộp qua AutoCAD Core Console -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VXT.RevitXuatCAD</AssemblyName>
    <RootNamespace>VXT.RevitXuatCAD</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Authors>Vũ Xuân Tuyến</Authors>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <OutputPath>..\..\bin\Revit\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RevitDir Condition="'$(RevitDir)'==''">C:\Program Files\Autodesk\Revit 2025\</RevitDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitDir)RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitDir)RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
